{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "mobile (.env)",
			"type": "dart",
			"request": "launch",
			"cwd": "mobile",
			"program": "lib/main.dart",
			"toolArgs": [
				"--dart-define-from-file=.env"
			]
		},
		{
			"name": "mobile (backend local)",
			"type": "dart",
			"request": "launch",
			"cwd": "mobile",
			"program": "lib/main.dart"
		},
		{
			"name": "mobile release (.env)",
			"type": "dart",
			"request": "launch",
			"cwd": "mobile",
			"program": "lib/main.dart",
			"flutterMode": "release",
			"toolArgs": [
				"--dart-define-from-file=.env"
			]
		}
	]
}
